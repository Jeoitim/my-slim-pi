{
  "settings": {
    "hostConfigDiscovery": "off",
    "ancestorConfigRoots": [],
    "projectServers": "ask",
    "allowInstall": false,
    "directTools": false,
    "namespaceProxyTools": false,
    "scriptMode": false,
    "exposeResources": false,
    "deferWithMissingMetadata": true,
    "mcpFooterStatus": "off",
    "showStatusIcon": false,
    "notifyOnStartupConnect": false,
    "sampling": false,
    "approveTools": true,
    "requestTimeoutMs": 30000,
