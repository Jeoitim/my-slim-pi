      "maxBytes": 24000,
      "maxLines": 350
    }
  },
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
      "lifecycle": "lazy",
      "directTools": false,
      "exposeResources": false,
      "includeTools": [
        "web_search_exa",
        "web_fetch_exa"
      ],
      "approveTools": true
    }
  }
}
