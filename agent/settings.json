{
  "editorPaddingX": 2,
  "autocompleteMaxVisible": 5,
  "hideThinkingBlock": false,
  "theme": "claude-warm",
  "collapseChangelog": true,
  "defaultTools": [
    "read",
    "powershell",
    "edit",
    "write"
  ],
  "quietStartup": false,
  "packages": [
    {
      "source": "npm:pi-cc-extensions@1.0.8",
      "extensions": []
    },
    {
      "source": "npm:pi-hermes-memory@0.9.11",
      "extensions": []
    },
    {
      "source": "npm:pi-hashline-edit-pro@6.5.1",
      "extensions": []
    },
    {
      "source": "npm:pi-permission-suite@0.2.3",
      "extensions": []
    },
    {
      "source": "npm:pi-subagents@0.80.0",
      "extensions": [],
      "skills": [],
      "prompts": []
    },
    {
      "source": "npm:principal-pi-skills@4.14.0",
      "extensions": [],
      "prompts": []
    },
    {
      "source": "npm:@anishthite/pi-themes@0.1.9",
      "extensions": [],
      "themes": [
        "themes/github-*.json"
      ]
    },
    "npm:@narumitw/pi-btw@0.62.0",
    "npm:pi-web-access@0.44.0",
    {
      "source": "npm:pi-ask-user@0.17.0",
      "extensions": [],
      "skills": [],
      "prompts": []
    },
    {
      "source": "npm:pi-tidy@0.4.11",
      "extensions": []
    }
  ],
  "markdown": {
    "mermaid": "final"
  },
  "extensions": [
    "-./extensions/timrt-suite/index.ts",
    "./npm/node_modules/pi-hermes-memory/src/pi-hermes-memory.compiled.mjs",
    "./npm/node_modules/pi-hashline-edit-pro/pi-hashline-edit-pro.compiled.mjs",
    "./npm/node_modules/pi-cc-extensions/extensions/pi-cc-extensions.compiled.mjs",
    "./extensions/timrt-suite/timrt-suite.compiled.mjs",
    "./npm/node_modules/pi-tidy/pi-tidy.compiled.mjs"
  ],
  "defaultProjectTrust": "ask",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "tidy": {
    "enabled": true,
    "icons": false,
    "frameUserMessages": false,
    "alwaysShowTools": [
      "edit",
      "write",
      "replace",
      "insert"
    ]
  }
}
